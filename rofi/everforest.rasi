* {
  font:   "System Default 13";

  bg0     : #1c1c1c;
  bg1     : #1c1c1c;
  bg2     : #1c1c1c;
  bg3     : #1c1c1c;
  fg0     : #7a8478;
  fg1     : #859289;
  fg2     : #d3c6aa;
  red     : #e67e80;
  green   : #a7c080;
  yellow  : #dbbc7f;
  blue    : #7fbbb3;
  magenta : #d699b6;
  cyan    : #83c092;

  accent: @green;
  urgent: @red;

  background-color : transparent;
  text-color       : @fg2;

  margin  : 0;
  padding : 0;
  spacing : 0;
}

configuration {
    show-icons: true;
}

window {
  location : center;
  width    : 360px;
  x-offset : 4px;
  y-offset : 26px;

  background-color: @bg1;
  border: 2px;
  border-color: @bg3;
  border-radius: 6px;
}

inputbar {
  spacing  : 8px;
  padding  : 12px 12px;
  children : [ entry ];
  background-color: @bg0;
}

listview {
  padding      : 12px 0px;
  lines        : 8;
  columns      : 1;
  scrollbar    : false;
  fixed-height : false;
  dynamic      : true;
}

element {
  padding : 10px 10px;
  spacing : 10px;
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected {
  text-color       : @bg1;
  background-color : @accent;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 1em;
}

element-text {
  text-color: inherit;
}
